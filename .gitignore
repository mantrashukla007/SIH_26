# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
*.spec

# ── Node / Frontend ───────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
.vite/

# ── Virtual environment ───────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Environment / Secrets (NEVER commit API keys) ─────────────
.env
!.env.example

# ── Generated / database files (rebuilt automatically by scripts on Render) ──
data/pdfs/
data/chroma_db/
data/qco_structured.db
data/*.log
data/supplement.log
data/scraper.log
data/failed_urls.log

# Track raw source data texts for build scripts (< 600 KB total)
!data/raw_documents.json
!data/qco_structured.csv
!data/.gitkeep

# ── IDE & OS ──────────────────────────────────────────────────
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── Temp / scratch ────────────────────────────────────────────
inspect_data.py
*.tmp
*.bak
